// ============================================================
//  main.typ —— 简历内容（你只需要改这个文件）
//
//  需要你填写的地方都用【】标出：搜索「【」就能逐个替换。
//  另外记得替换下面的电话、邮箱等占位符。
//
//  编译：typst compile main.typ
//  预览：typst watch main.typ     （保存后自动重新编译）
//
//  条目说明见 template.typ；想换字体、字号也改那里。
// ============================================================

#import "template.typ": *

// ------------------------------------------------------------
//  抬头：姓名 + 联系方式
//  contacts 里每一项都是一段内容，用逗号分隔，会自动用 " | " 连接。
//  常用写法：
//      link("tel:+8613800138000", "+86 138-0013-8000")
//      link("mailto:you@example.com", "you@example.com")
//      link("https://github.com/yourname", "github.com/yourname")
//      纯文字（不加链接）直接写字符串即可
// ------------------------------------------------------------
#show: resume.with(
  name: "【姓名】",
  contacts: (
    link("tel:+8613800138000", "+86 138-0013-8000"),
    link("mailto:your_email@example.com", "your_email@example.com"),
    // link("https://github.com/yourname", "github.com/yourname"),
    // link("https://your-site.example.com", "your-site.example.com"),
  ),
)

// ------------------------------------------------------------
//  教育经历
//  参数：university 学校 / degree 学位 / school 专业 / start 起 / end 止
//  只填 start 不填 end 会显示成「20XX.09 – 今」
// ------------------------------------------------------------
#resume-section("教育经历")
#resume-education(
  university: "【学校名称】",
  degree: "工学学士",
  school: "【专业名称】",
  start: "20XX.09",
  end: "20XX.06",
)[
  *学院：*【学院名称】。*主攻方向：*【方向一】、【方向二】、【方向三】。
]

// ------------------------------------------------------------
//  学生工作与经历
//  参数：company 单位 / duty 职务 / start 起 / end 止
//  duty 留空时不会留下多余的「 | 」
// ------------------------------------------------------------
#resume-section("学生工作与经历")

#resume-work(
  company: "【实验室 / 组织名称】",
  duty: "【担任职务】",
  start: "20XX.XX",
  end: "至今",
)[
  - 【职责一：负责什么、用了什么方法、取得了什么结果。】
  - 【职责二：能量化就写数字，例如“累计发布 N 条视频，单条最高播放量 X 万”。】
]

// ------------------------------------------------------------
//  项目与比赛经历
//  参数：title 项目名 / duty 角色 / start 起 / end 止 / note 右侧备注
//
//  · 想突出成果，把关键词用 *星号* 包起来即可加粗。
//  · note 用来替换右侧时间（例如专利号）；传了 note 就忽略 start / end。
//  · 不需要日期时，start / end 都不写，右侧不会出现横线。
// ------------------------------------------------------------
#resume-section("项目与比赛经历")

#resume-project(
  title: "【项目名称一】",
  duty: "【担任角色】",
  start: "20XX.XX",
  end: "20XX.XX",
)[
  - 【技术方案：用了什么算法 / 框架 / 硬件，解决了什么问题。】
  - 【量化结果：精度、速度、提升倍数等，*获奖或结论可以这样加粗*。】
]

#resume-project(
  title: "【项目名称二】",
  duty: "【担任角色】",
  start: "20XX.XX",
  end: "20XX.XX",
)[
  - 【技术方案一。】
  - 【技术方案二，*获得 XX 竞赛国家一等奖*。】
]

#resume-project(
  title: "【项目名称三】",
  duty: "【担任角色】",
  start: "20XX.XX",
  end: "20XX.XX",
)[
  - 【技术方案与结果。】
]

// ------------------------------------------------------------
//  技能特长
//  普通的 - 列表。注意每一项都要以「- 」开头，
//  否则会被当成上一条的续行而挤在同一段里。
// ------------------------------------------------------------
#resume-section("技能特长")

- *编程语言与系统*：【语言与操作系统，例如 Python、C++、Ubuntu。】
- *框架与工具*：【例如 ROS 1 / ROS 2、Git、Docker、CMake。】
- *仿真与算法*：【例如 IsaacLab、IsaacSim、强化学习、sim2real 迁移经验。】
- *硬件与部署*：【例如上位机选型、边缘计算平台部署与驱动调试。】
- *其他*：【语言成绩、证书等。】

// ------------------------------------------------------------
//  其他荣誉奖项与专利
//  · 荣誉这类没有日期、没有职务的条目：只写 title 即可。
//  · 专利号这类右侧信息：用 note 参数。
// ------------------------------------------------------------
#resume-section("其他荣誉奖项与专利")

#resume-project(
  title: "曾获荣誉奖项",
)[
  - 【奖项一（年份）】
  - 【奖项二（年份）】
]

#resume-project(
  title: "发明专利",
  duty: "【专利名称】",
  note: "专利号 ZL000000000000.0",
)[
  - 【你负责的部分一。】
  - 【你负责的部分二。】
]
